{
  "name": "react-native-nitro-onnx",
  "version": "0.1.1",
  "description": "React Native Nitro module wrapping sherpa-onnx for local ASR, TTS, VAD and voice cloning",
  "license": "MIT",
  "homepage": "https://github.com/zydbkqf/react-native-nitro-onnx",
  "author": "Denis Cheung (https://github.com/zydbkqf)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "source": "src/index.ts",
  "scripts": {
    "postinstall": "node scripts/prepare-sherpa-onnx.js",
    "prespecs": "node scripts/prepare-sherpa-onnx.js",
    "build": "tsc",
    "specs": "nitrogen",
    "test": "jest",
    "test:cpp": "node scripts/test-cpp.js"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.78.0",
    "react-native-nitro-modules": ">=0.35.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "nitrogen": "*",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.35.8",
    "ts-jest": "^29.1.0",
    "typescript": "5.4.5"
  },
  "files": [
    "src",
    "!src/__tests__",
    "!src/__mocks__",
    "lib",
    "!lib/__tests__",
    "!lib/__mocks__",
    "cpp",
    "!cpp/tests",
    "!cpp/build*",
    "!cpp/sherpa-onnx-prebuilt",
    "android",
    "ios",
    "assets",
    "scripts",
    "Package.swift",
    "nitro.json",
    "nitrogen",
    "NitroOnnxSpeech.podspec",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "packageManager": "yarn@4.17.1"
}
